local function GetBossNames()
    local names = {}
    local monsterFolder = ReplicatedStorage:FindFirstChild("Monster")
    local bossFolder = monsterFolder and monsterFolder:FindFirstChild("Boss")
    if bossFolder then
        for _, obj in pairs(bossFolder:GetChildren()) do
