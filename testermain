--// Smooth & Bug-Free Draggable Logic
local function MakeDragable(frame, onClickCallback)
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    local isMoving = false
    local releaseConn = nil

    -- Start drag ONLY when clicking the frame itself
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            isMoving = false
            dragStart = input.Position
            startPos = frame.Position

            -- Disconnect any stale listener from a previous press before making a new one
            if releaseConn then
                releaseConn:Disconnect()
                releaseConn = nil
            end

            -- Detect when THIS specific click is released
            releaseConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if releaseConn then
                        releaseConn:Disconnect()
                        releaseConn = nil
                    end
                    -- If we didn't drag it far, treat as a click
                    if not isMoving and onClickCallback then
                        onClickCallback()
                    end
                end
            end)
        end
    end)

    -- Track mouse movements over the frame to update dragInput
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    -- Use UserInputService for the actual movement so it doesn't lag when mouse leaves the frame
    local globalConn = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then
                isMoving = true
            end
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    table.insert(getgenv().AutoFarmHubGlobalConnections, globalConn)
end

